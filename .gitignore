*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.iso

# Profiling / temp
tmp/
temp/
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
*.local
*.cpuprofile
*.heapprofile
.eslintcache
.stylelintcache
.prettiercache
.serverless/
