PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Supabase Postgres (Project Settings → Database → Connection string → Session pooler)
# Direct db.*.supabase.co is IPv6-only. Use the Session pooler on IPv4 networks.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# Max DB connections in the pool (keep small on Supabase free tier)
PG_POOL_MAX=5

# Google Sign-In (HQ login for all accounts + company signup)
# Create an OAuth Web client in Google Cloud Console. Put the real values in backend/.env only.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Producer Super Admin (comma-separated). Only these emails may hold Super Admin.
# Account is created on boot when SUPER_ADMIN_EMAIL + SUPER_ADMIN_PASSWORD are set.
# Put real values in backend/.env only.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_EMAILS=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_RETIRED_EMAILS=

# Product images (Cloudinary) — max upload size enforced at 1 MB
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# HQ welcome / account emails (Nodemailer)
# When SMTP is not set, emails are logged to the API console instead of sent,
# and forgot-password returns the reset token to the caller instead of emailing.
# Gmail: use an App Password. SMTP_FROM must be the same Gmail address as SMTP_USER.
HQ_APP_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="POS HQ <you@gmail.com>"
