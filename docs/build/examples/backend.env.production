# Copy to backend/.env on the machine that hosts the API.

PORT=3001
CORS_ORIGINS=http://localhost:3000,http://192.168.1.10:3000,https://tauri.localhost

# Supabase Postgres (Project Settings → Database → Connection string → Session pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Max DB connections in the pool (keep small on Supabase free tier)
PG_POOL_MAX=5

# Google Sign-In (OAuth Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary — product image / large-file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

HQ_APP_URL=https://hq.yourdomain.com
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="POS HQ <noreply@yourdomain.com>"
