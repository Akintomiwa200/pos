{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Terminal",
  "version": "0.1.0",
  "identifier": "com.pos.terminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "POS Terminal",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  }
}
