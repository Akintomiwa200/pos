PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:1420

# Google Sign-In (HQ login for all accounts + company signup)
# Create an OAuth Web client in Google Cloud Console and set the client ID here.
# Mirror the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the web app.
GOOGLE_CLIENT_ID=

# Product images (Cloudinary) — max upload size enforced at 1 MB
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# HQ welcome / account emails (Nodemailer)
# When SMTP is not set, emails are logged to the API console instead of sent.
HQ_APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="POS HQ <noreply@example.com>"
